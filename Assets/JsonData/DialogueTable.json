[
  {
    "DialogueId": 700101,
    "Lines": [
      { "Speaker": "Npc",    "Name": "",       "PortraitAddress": "", "Text": "어서 오게, 모험가여." },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "무슨 일이죠?" },
      { "Speaker": "Npc",    "Name": "",       "PortraitAddress": "", "Text": "마을 앞 들판에 슬라임이 들끓고 있네." },
      { "Speaker": "Other",  "Name": "경비병",  "PortraitAddress": "", "Text": "촌장님! 또 나타났습니다!" },
      { "Speaker": "Npc",    "Name": "",       "PortraitAddress": "", "Text": "보게, 자네 도움이 필요하네. 슬라임 한 마리만 처치해 주게." },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "맡겨만 주세요." }
    ]
  },
  {
    "DialogueId": 700102,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "실력이 제법이군. 이번엔 좀 더 큰 일이네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "던전 입구의 몬스터들을 정리해 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "알겠습니다." }
    ]
  },
  {
    "DialogueId": 700103,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "이제 자네에게 새 힘을 각성시킬 때가 됐네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "더 강한 적을 물리치고 돌아오게. 그때 진정한 힘을 얻을 걸세." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "다녀오겠습니다." }
    ]
  },
  {
    "DialogueId": 700104,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "마을 주변에 또 슬라임이 꼬였네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "다섯 마리만 정리해 주면 주민들이 발 뻗고 자겠어." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "돌아보고 오겠습니다." }
    ]
  },
  {
    "DialogueId": 700105,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "요즘 들개들이 마을 어귀까지 내려와." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "세 마리쯤 쫓아내 주면 한동안은 잠잠하겠지." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "처리하고 오죠." }
    ]
  },
  {
    "DialogueId": 700111,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "오, 벌써 해치웠나! 역시 자네야." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "약속한 보상일세, 받게." }
    ]
  },
  {
    "DialogueId": 700112,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "던전이 한결 조용해졌군. 수고했네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "이건 자네 몫이야." }
    ]
  },
  {
    "DialogueId": 700113,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "해냈군! 이제 자네도 한 단계 올라섰어." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "약속한 것을 주지. 앞으로도 부탁하네." }
    ]
  },
  {
    "DialogueId": 700114,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "순찰 다녀왔나? 덕분에 마음이 놓이는군." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "얼마 안 되지만 받게." }
    ]
  },
  {
    "DialogueId": 700115,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "들개들이 잠잠해졌어. 고맙네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "이건 사례일세." }
    ]
  },
  {
    "DialogueId": 700190,
    "Npc": "칼슨",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "어서 오게, 젊은이." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오늘도 마을은 평화롭구먼." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "자네 같은 젊은이가 있어 마을이 든든하네." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "무슨 볼일이라도 있는가?" }
    ]
  },
  {
    "DialogueId": 700290,
    "Npc": "미라",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "약초는 항상 필요하답니다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋은 재료 있으면 언제든 가져와요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오늘도 수고가 많네요." }
    ]
  },
  {
    "DialogueId": 700301,
    "Npc": "초짜",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "우와! 이게 얼마만이야!" },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "절 아시나요..?" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "아니, 그냥 여기서 누군가를 보는 거 자체가 오랜만이라서." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "아무튼! 자네가 해줄 일이 있네." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "(분명 초면이라 하지 않았나..)" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "다음 문을 지나면 로봇 네 개가 있을걸세! 좀 없애주게나." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "어차피 움직이지도 못하니 쓸모가 없어져버려서 말이지." }
    ]
  },
  {
    "DialogueId": 700302,
    "Npc": "초짜",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오랜만에 또 나타났어.." },
      { "Speaker": "Other", "Name": "칼슨", "PortraitAddress": "", "Text": "이번에는 잘 해낼 수 있어야 할텐데 말이죠.." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "으악! 깜짝이야!" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하하! 이걸 처음 만난다고 해야하나 아니면 다시 보게됐다고 해야하나?" },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "뭐가 어떻게 흘러가고 있는겁니까!" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "로봇은 잘 없애주었군! 고맙네!" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "자 이제 내가 어디로 보내줄테니 칼슨을 찾아 말을 걸게나!" },
      { "Speaker": "Other", "Name": "칼슨", "PortraitAddress": "", "Text": "나를 꼭 찾아서 말을 걸어주세요.." }
    ]
  }
]
