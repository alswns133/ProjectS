[
  {
    "DialogueId": 700101,
    "Lines": [
      { "Speaker": "Npc",    "Name": "",       "PortraitAddress": "", "Text": "어서 오게, 귀환자." },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "무슨 일이죠?" },
      { "Speaker": "Npc",    "Name": "",       "PortraitAddress": "", "Text": "격리선 경계에 캣 워커가 계속 넘어오고 있네." },
      { "Speaker": "Other",  "Name": "정비공",  "PortraitAddress": "", "Text": "반장님! 또 한 기 넘어왔습니다!" },
      { "Speaker": "Npc",    "Name": "",       "PortraitAddress": "", "Text": "보게. 우선 한 기만 무력화해 실력을 보여 주게." },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "맡겨만 주세요." }
    ]
  },
  {
    "DialogueId": 700102,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "실력이 제법이군. 이번엔 좀 더 큰 일이네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "균열 입구의 공동체들을 정리해 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "알겠습니다." }
    ]
  },
  {
    "DialogueId": 700103,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "상공의 캣 슈터가 균열 안쪽으로 가는 길을 막고 있네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "다섯 기만 떨어뜨리면 길이 열릴 걸세." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "다녀오겠습니다." }
    ]
  },
  {
    "DialogueId": 700104,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "노드 주변에 또 캣 워커가 꼬였네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "다섯 기만 정리해 주면 주민들이 발 뻗고 자겠어." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "돌아보고 오겠습니다." }
    ]
  },
  {
    "DialogueId": 700105,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "요즘 캣 슈터가 노드 어귀까지 내려와." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "세 기쯤 쫓아내 주면 한동안은 잠잠하겠지." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "처리하고 오죠." }
    ]
  },
  {
    "DialogueId": 700111,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "오, 벌써 해치웠나! 역시 자네야." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "약속한 보상일세, 받게." }
    ]
  },
  {
    "DialogueId": 700112,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "던전이 한결 조용해졌군. 수고했네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "이건 자네 몫이야." }
    ]
  },
  {
    "DialogueId": 700113,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "해냈군! 이제 자네도 한 단계 올라섰어." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "약속한 것을 주지. 앞으로도 부탁하네." }
    ]
  },
  {
    "DialogueId": 700114,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "순찰 다녀왔나? 덕분에 마음이 놓이는군." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "얼마 안 되지만 받게." }
    ]
  },
  {
    "DialogueId": 700115,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "그쪽이 잠잠해졌어. 고맙네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "이건 사례일세." }
    ]
  },
  {
    "DialogueId": 700190,
    "Npc": "칼슨",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "어서 오게, 귀환자." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오늘도 노드는 조용하군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "자네 같은 귀환자가 있어 노드가 든든하네." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "무슨 볼일이라도 있는가?" }
    ]
  },
  {
    "DialogueId": 700290,
    "Npc": "멀스",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "약초는 항상 필요하답니다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋은 재료 있으면 언제든 가져와요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오늘도 수고가 많네요." }
    ]
  },
  {
    "DialogueId": 700301,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "장비를 강화하려면 손상된 코어가 있어야 해." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "던전 놈들 몸속에 그게 박혀 있지. 세 개만 회수해 오게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "코어라면 어떻게든 구해 오죠." }
    ]
  },
  {
    "DialogueId": 700302,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "담금질엔 질 좋은 금속이 많이 든다네." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "쓰지 않는 방어구라도 좋으니 세 벌만 가져와 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "모아서 돌아오겠습니다." }
    ]
  },
  {
    "DialogueId": 700311,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오, 코어가 아주 실하군! 이 정도면 화력이 제대로 오르겠어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "수고했네, 이건 사례일세." }
    ]
  },
  {
    "DialogueId": 700312,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋은 쇠붙이야. 이거면 한동안 화로가 든든하겠어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "약속한 물건일세. 받게." }
    ]
  },
  {
    "DialogueId": 700390,
    "Npc": "게롯",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "왔는가. 화로는 오늘도 뜨겁다네." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "무기든 방어구든, 강하게 만들 자신은 있으니 언제든 들르게." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋은 재료만 있다면 말이지." }
    ]
  },
  {
    "DialogueId": 700401,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "보다시피 진열대가 텅 비었어. 이래선 장사가 안 되지." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "팔 만한 방어구 네 점만 구해다 주면 값은 후하게 쳐주겠네." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "채워서 가져오죠." }
    ]
  },
  {
    "DialogueId": 700402,
    "Lines": [
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "요즘 운송로에 캣 워커가 들끓어 화물차가 못 나가." },
      { "Speaker": "Npc",    "Name": "", "PortraitAddress": "", "Text": "여섯 마리만 치워 주면 길이 뚫릴 걸세. 부탁하네." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "길은 제가 열어 드리죠." }
    ]
  },
  {
    "DialogueId": 700411,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오, 물건이 제법이군! 이 정도면 진열대가 살아나겠어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "약속한 값일세. 앞으로도 잘 부탁하네." }
    ]
  },
  {
    "DialogueId": 700412,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "길이 뚫렸다는 소식 들었네. 덕분에 수레가 다시 굴러가." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이건 사례일세. 요긴하게 쓰게." }
    ]
  },
  {
    "DialogueId": 700490,
    "Npc": "바로",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "어이, 손님! 좋은 물건 많으니 천천히 둘러보게." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "필요한 게 있으면 값은 얼마든 흥정해 주지." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "장사는 발이 넓어야 하는 법이라네." }
    ]
  },
  {
    "DialogueId": 700501,
    "Lines": [
      { "Speaker": "Other",  "Name": "의뢰문", "PortraitAddress": "", "Text": "매니악 구역에 캣 워커가 떼로 들끓고 있소. 여덟 기만 처리해 주시오. — 외곽 주민 다린 —" },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "이 의뢰, 받아 두지." }
    ]
  },
  {
    "DialogueId": 700502,
    "Lines": [
      { "Speaker": "Other",  "Name": "의뢰문", "PortraitAddress": "", "Text": "매니악을 돌면 나온다는 상급 강화석이 급히 필요하오. 세 개만 맡겨 주시오. — 수선공 헤이즐 —" },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "모아서 가져오지." }
    ]
  },
  {
    "DialogueId": 700503,
    "Lines": [
      { "Speaker": "Other",  "Name": "의뢰문", "PortraitAddress": "", "Text": "매니악 상공에 캣 슈터가 다섯 기 떠 있다는 보고요. 처치해 주시오. — 파수꾼 오스카 —" },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "다녀오지." }
    ]
  },
  {
    "DialogueId": 700511,
    "Lines": [
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "의뢰 완료를 확인했소. 여기 약속한 사례요. 고맙소." }
    ]
  },
  {
    "DialogueId": 700512,
    "Lines": [
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "물건 잘 받았소. 여기 값을 두고 가오." }
    ]
  },
  {
    "DialogueId": 700513,
    "Lines": [
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "하늘이 다시 조용해졌군. 약속한 보수요. 수고했소." }
    ]
  },
  {
    "DialogueId": 700504,
    "Lines": [
      { "Speaker": "Other",  "Name": "의뢰문", "PortraitAddress": "", "Text": "그 건물 안쪽에 볼트너클이 계속 나온다더군. 여덟 기만 처리해 주시오. — 정찰대원 리코 —" },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "이 의뢰, 받아 두지." }
    ]
  },
  {
    "DialogueId": 700514,
    "Lines": [
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "의뢰 완료를 확인했소. 여기 약속한 사례요. 고맙소." }
    ]
  },
  {
    "DialogueId": 700505,
    "Lines": [
      { "Speaker": "Other",  "Name": "의뢰문", "PortraitAddress": "", "Text": "건물 하드 구역 상공에 아크캐논이 조준을 걸고 있다는군. 여덟 기만 떨어뜨려 주시오. — 기술자 노아 —" },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "이 의뢰, 받아 두지." }
    ]
  },
  {
    "DialogueId": 700515,
    "Lines": [
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "의뢰 완료를 확인했소. 여기 약속한 사례요. 고맙소." }
    ]
  },
  {
    "DialogueId": 700506,
    "Lines": [
      { "Speaker": "Other",  "Name": "의뢰문", "PortraitAddress": "", "Text": "매니악 구역은 볼트너클과 아크캐논이 뒤섞여 있소. 목숨을 걸어야 할 거요. 둘 다 네 기씩 처리해 주시오. — 생존자 마야 —" },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "이 의뢰, 받아 두지." }
    ]
  },
  {
    "DialogueId": 700516,
    "Lines": [
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "의뢰 완료를 확인했소. 여기 약속한 사례요. 고맙소." }
    ]
  },
  {
    "DialogueId": 700507,
    "Lines": [
      { "Speaker": "Other",  "Name": "의뢰문", "PortraitAddress": "", "Text": "건물을 돌면 하급 강화석이 잔뜩 나온다더군. 스무 개만 맡겨 주시오. — 수선공 델라 —" },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "모아서 가져오지." }
    ]
  },
  {
    "DialogueId": 700517,
    "Lines": [
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "물건 잘 받았소. 여기 값을 두고 가오." }
    ]
  },
  {
    "DialogueId": 700508,
    "Lines": [
      { "Speaker": "Other",  "Name": "의뢰문", "PortraitAddress": "", "Text": "하드 구역을 돌면 상급 강화석도 꽤 나온다는군. 열 개만 맡겨 주시오. — 정비반장 후고 —" },
      { "Speaker": "Player", "Name": "",       "PortraitAddress": "", "Text": "모아서 가져오지." }
    ]
  },
  {
    "DialogueId": 700518,
    "Lines": [
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "물건 잘 받았소. 여기 값을 두고 가오." }
    ]
  },
  {
    "DialogueId": 700590,
    "Npc": "게시판",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "낡은 게시판에 여러 의뢰문이 빼곡히 붙어 있다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "노드 곳곳에서 올라온 의뢰들이다. 마음에 드는 것을 골라 보자." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "완료한 의뢰는 다시 이곳에서 보고하면 된다." }
    ]
  },
  {
    "DialogueId": 700601,
    "Lines": [
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "절 아시나요..?" },
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "아니, 그냥 여기서 누군가를 보는 거 자체가 오랜만이라서." },
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "아무튼! 자네가 해줄 일이 있네." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "(분명 초면이라 하지 않았나..)" },
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "다음 문을 지나면 로봇 네 개가 있을걸세! 좀 없애주게나." },
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "어차피 공격도 못하니 하나도 위험하지 않을걸세." }
    ]
  },
  {
    "DialogueId": 700602,
    "Lines": [
      { "Speaker": "Other", "Name": "칼슨", "PortraitAddress": "", "Text": "이번에는 잘 해낼 수 있어야 할텐데 말이죠.." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "으악! 깜짝이야!" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하하! 이걸 처음 만난다고 해야하나 아니면 다시 보게됐다고 해야하나?" },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "뭐가 어떻게 흘러가고 있는겁니까!" },
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "로봇은 잘 없애주었군! 고맙네!" },
      { "Speaker": "Other", "Name": "의뢰문", "PortraitAddress": "", "Text": "자 이제 내가 세컨드 노드로 보내줄테니 칼슨을 찾아 말을 걸게나!" },
      { "Speaker": "Other", "Name": "칼슨", "PortraitAddress": "", "Text": "나를 꼭 찾아서 말을 걸어주세요.." }
    ]
  },
  {
    "DialogueId": 700690,
    "Npc": "초짜",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "우와! 이게 얼마만이야!" }
    ]
  },
  {
    "DialogueId": 700691,
    "Npc": "초짜",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오랜만에 또 나타났어.." }
    ]
  },
  {
    "DialogueId": 700701,
    "Npc": "비석",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이렇게 쓰여져있다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "뛰어라.." }
    ]
  },
  {
    "DialogueId": 700106,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "자네가 새로 들어온 귀환자인가." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "무엇부터 하면 됩니까?" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "격리선 게이트가 잠겨 있네. 문 앞까지 가 보게. 거기서 다시 이야기하지." }
    ]
  },
  {
    "DialogueId": 700116,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "잘 왔네. 지금 막 통제를 풀었어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이 너머가 사이버싸이코 균열일세. 각성체 나인클로가 버티고 있지." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "바로 들어가겠습니다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그 고스트로는 무리야. 공장에서 막 나온 물건 아닌가." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "코어 두 조각과 크레딧을 들려 보내지. 게롯에게 가서 한 단계 올리고 오게." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그게 자네 첫 임무일세." }
    ]
  },
  {
    "DialogueId": 700117,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "나인클로가 멎었다는 신호를 받았네. 훌륭해." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "약속한 보상일세. 앞으로도 부탁하네." }
    ]
  },
  {
    "DialogueId": 700107,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이 너머는 자네 혼자 들어가야 하네." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "각성체 나인클로를 파괴하면 공동체 분출이 멎을 걸세." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "다녀오겠습니다." }
    ]
  },
  {
    "DialogueId": 700108,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오, 벌써 이렇게 강해졌군!" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "슬슬 새로운 힘이 깨어날 때가 됐어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하드 균열의 나인클로를 넘어서 보게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가겠습니다." }
    ]
  },
  {
    "DialogueId": 700118,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋아, 이 정도면 됐어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "새로운 힘이 자네 안에서 깨어나는 게 느껴지는군." }
    ]
  },
  {
    "DialogueId": 700109,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "매니악 균열 쪽 캣 워커가 심상치 않게 몰려 있다는 보고다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "열다섯 마리는 정리해야 길이 트이겠어." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가겠습니다." }
    ]
  },
  {
    "DialogueId": 700119,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "정말 해냈군. 이 무기, 자네에게 어울릴 걸세." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받아 두게." }
    ]
  },
  {
    "DialogueId": 700110,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "매니악 균열의 나인클로가 완전히 각성했다는 보고다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번엔 끝을 봐야겠어. 자네라면 할 수 있을 걸세." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가겠습니다." }
    ]
  },
  {
    "DialogueId": 700120,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "정말 해냈군. 매니악까지 완전히 정리했어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그런데 균열 안쪽에서 수상한 건물을 발견했다는 보고가 들어왔네. 나중에 다시 이야기하지." }
    ]
  },
  {
    "DialogueId": 700121,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그 수상한 건물 말일세 — 안쪽을 좀 더 살펴봐야겠어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "먼저 볼트너클 다섯 기만 정리해 주게. 길을 트고 들어가 봐야지." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가겠습니다." }
    ]
  },
  {
    "DialogueId": 700131,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "무사히 돌아왔군. 생각보다 위험했을 텐데, 잘 갔다 왔어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이건 그 값이네. 계속 조사해 봐야겠어." }
    ]
  },
  {
    "DialogueId": 700122,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그 건물 심장부에 코어브레이커라는 게 있다는 보고다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번엔 진짜 위험할 거야. 그래도 자네라면 해낼 수 있어." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가겠습니다." }
    ]
  },
  {
    "DialogueId": 700132,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "정말 해냈군! 코어브레이커까지 무너뜨리다니." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이 정도면 새로운 스킬도 문제없이 익힐 수 있겠어. 받아 두게." }
    ]
  },
  {
    "DialogueId": 700123,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "던전2 하드 쪽 볼트너클이 심상치 않게 몰려 있다는 보고다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "열 마리만 정리해 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가겠습니다." }
    ]
  },
  {
    "DialogueId": 700133,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "역시 자네군. 하드 구역이 한결 조용해졌어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "수고했네." }
    ]
  },
  {
    "DialogueId": 700124,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하드 균열 심장부에 코어브레이커가 다시 나타났다는 보고다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번에도 자네한테 맡기지." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가겠습니다." }
    ]
  },
  {
    "DialogueId": 700134,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "또 해냈군. 하드 쪽 코어브레이커까지." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받아 두게." }
    ]
  },
  {
    "DialogueId": 700125,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "던전2 매니악 구역이 완전히 난장판이라는 보고다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "볼트너클 열다섯, 아크캐논 다섯 — 한꺼번에 정리해 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가겠습니다." }
    ]
  },
  {
    "DialogueId": 700135,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "정말 대단하군. 매니악 구역까지 깨끗해졌어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받아 두게." }
    ]
  },
  {
    "DialogueId": 700126,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "매니악 균열 심장부의 코어브레이커, 완전히 각성했다는 보고다." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번이 진짜 마지막 고비일세. 부탁하네." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가겠습니다." }
    ]
  },
  {
    "DialogueId": 700136,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "정말 해냈군! 매니악의 코어브레이커까지 무너뜨리다니." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그리고... 시그널이 완전히 개화한 게 느껴지는군. 각성기를 다룰 수 있게 됐어." }
    ]
  },
  {
    "DialogueId": 700127,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "매니악 균열에서 얻은 정보로 레이드 균열, 퍼스트 노드의 위치를 알아냈네." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "게이트가 아직 잠겨 있어. 문 앞까지 가 보게. 거기서 다시 이야기하지." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가보겠습니다." }
    ]
  },
  {
    "DialogueId": 700137,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "여기까지 왔군. 이 너머가 레이드 균열, 퍼스트 노드일세." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이 유물 무기를 챙겨 가게. 레이드 보스가 버티고 있으니, 준비되면 들어가게." }
    ]
  },
  {
    "DialogueId": 700128,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "드디어 여기까지 왔군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "레이드 보스, 처형 기체 헤카톤을 정지시키면 이 모든 게 끝나네. 부탁하네, 마지막이야." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "다녀오겠습니다." }
    ]
  },
  {
    "DialogueId": 700138,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "...해냈군. 정말 해냈어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "자네 덕분에 공동체 분출이 완전히 멎었네. 고맙네, 귀환자." }
    ]
  },
  {
    "DialogueId": 700303,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "칼슨이 보냈군. 고스트는 쓸수록 손에 붙는 법이야." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받아 온 코어를 먹여서 한 단계 끌어올려 보게. 강화대는 열어 뒀네." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "해보겠습니다." }
    ]
  },
  {
    "DialogueId": 700313,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "느껴지나? 시그널이 한결 곧게 흐르지." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이만하면 균열에 발은 들이겠어. 칼슨이 노드 쪽부터 보라더군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "코어는 계속 모아 두게. 위로 올라갈수록 많이 먹으니까." }
    ]
  },
  {
    "DialogueId": 700304,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그 무기, 아직 다 갈리지 않았어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "+3까지는 만들어야 제 몫을 하지. 재료는 챙겨 왔나?" },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "해보겠습니다." }
    ]
  },
  {
    "DialogueId": 700314,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이제야 좀 봐줄 만하군. 시그널이 완전히 달라." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "앞으로가 더 기대되는군." }
    ]
  },
  {
    "DialogueId": 700305,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그 무기만 벼려서 되겠나, 방어구도 한 벌 맞춰야지." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "재료는 미리 챙겨야 아쉬운 소리 안 하지." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하급 강화석 열 개만 모아다 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "구해 오겠습니다." }
    ]
  },
  {
    "DialogueId": 700315,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이 정도면 한동안 든든하겠군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "고맙네." }
    ]
  },
  {
    "DialogueId": 700306,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번엔 하의 쪽을 손봐야겠어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하급 강화석 열 개만 더 구해다 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "다시 다녀오겠습니다." }
    ]
  },
  {
    "DialogueId": 700316,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋아, 이제 한 세트가 맞아 들어가는군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "고맙네." }
    ]
  },
  {
    "DialogueId": 700307,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번엔 신발이다. 하급 강화석 열 개만 더 모아다 주게." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "부족하면 미라 잡화점에서 사거나, 던전을 돌아도 꽤 나올 걸세." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "알겠습니다." }
    ]
  },
  {
    "DialogueId": 700317,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "상의, 하의, 신발까지 왔군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "고생 많았네." }
    ]
  },
  {
    "DialogueId": 700308,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "참, 헬멧도 있었군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하급 강화석 열 개만 더 구해다 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오겠습니다." }
    ]
  },
  {
    "DialogueId": 700318,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이제야 온전한 한 벌이군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "아주 든든하겠어." }
    ]
  },
  {
    "DialogueId": 700309,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그 낡은 무기들, 나한테 넘기게." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "노말 Lv1 무기 하나, 매직 Lv5 무기 하나 — 녹여서 재료로 돌려주지." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오겠습니다." }
    ]
  },
  {
    "DialogueId": 700319,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋아, 이 정도면 충분히 뽑아낼 수 있겠어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "강화석일세. 요긴하게 쓰게." }
    ]
  },
  {
    "DialogueId": 700310,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번엔 진짜다. 10레벨 무기를 +5까지 끌어올려 보게." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "4강부터는 상급 강화석도 먹으니, 방금 준 것들 아껴 쓰게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "해보겠습니다." }
    ]
  },
  {
    "DialogueId": 700320,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "+5라... 이 정도면 어디 가서도 안 밀리겠군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "수고했네." }
    ]
  },
  {
    "DialogueId": 700321,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그 건물 안쪽 기체들, 하급 강화석을 잔뜩 떨구더군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "쟁여둔 거 있으면 좀 넘겨주게. 쓸 데가 많아." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져다드리죠." }
    ]
  },
  {
    "DialogueId": 700331,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오, 이만큼이나. 당분간은 든든하겠군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "고맙네." }
    ]
  },
  {
    "DialogueId": 700322,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그 레어 무기, 20레벨짜리로 갈아 끼워 줄 수 있어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "지금 쓰는 15레벨 레어 무기를 가져오게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오겠습니다." }
    ]
  },
  {
    "DialogueId": 700332,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋아, 이걸로 바꿔주지." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "확실히 물건이 다르지." }
    ]
  },
  {
    "DialogueId": 700323,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이제 진짜 마지막이야. 그 무기, +9까지 만들어 보자고." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "7강부터는 실패율이 확 뛰니까 각오는 하게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "해보겠습니다." }
    ]
  },
  {
    "DialogueId": 700333,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "+9라니... 이 정도면 전설급이군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "정말 큰일을 해냈어. 이건 그만한 값이네." }
    ]
  },
  {
    "DialogueId": 700324,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이제 레어 등급 방어구도 만져볼 때가 됐어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "상급 강화석 스무 개만 가져오면, 25레벨 레어 상의로 바꿔주지." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오겠습니다." }
    ]
  },
  {
    "DialogueId": 700334,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋아, 이 정도면 어깨가 든든하겠군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받아 두게." }
    ]
  },
  {
    "DialogueId": 700325,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번엔 하의 차례야." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "상급 강화석 스무 개만 더 가져오게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오겠습니다." }
    ]
  },
  {
    "DialogueId": 700335,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "위아래는 이제 갖췄군. 다음은 헬멧이야." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받아 두게." }
    ]
  },
  {
    "DialogueId": 700326,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "헬멧도 레어로 바꿔줄 수 있어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "상급 강화석 스무 개만 더 가져오게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오겠습니다." }
    ]
  },
  {
    "DialogueId": 700336,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋아, 머리까지 갖췄군. 이제 신발만 남았어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받아 두게." }
    ]
  },
  {
    "DialogueId": 700327,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이제 마지막, 신발이야." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "상급 강화석 스무 개만 더 가져오면 세트가 완성되네." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오겠습니다." }
    ]
  },
  {
    "DialogueId": 700337,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "드디어 세트가 완성됐군!" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이 정도면 매니악도 두렵지 않겠어." }
    ]
  },
  {
    "DialogueId": 700403,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "화물차가 또 못 나갔어. 상공에서 캣 슈터가 조준을 걸거든." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "다섯 기만 떨어뜨려 주면 조달로가 다시 돌아가네." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "정리하고 오겠습니다." }
    ]
  },
  {
    "DialogueId": 700413,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하늘이 뚫렸다는 보고가 왔네. 덕분에 물건이 들어와." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이건 사례일세." }
    ]
  },
  {
    "DialogueId": 700404,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번엔 하드 구역이야. 캣 워커 놈들이 갑절로 늘었어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "열 마리는 정리해야 길이 뚫리겠네." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "다녀오겠습니다." }
    ]
  },
  {
    "DialogueId": 700414,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "역시 자네군. 이 정도면 운송로가 숨통 트이겠어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "수고 많았네." }
    ]
  },
  {
    "DialogueId": 700405,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하드 쪽 상공에 캣 슈터가 다섯 기나 떠 있다더군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번에도 자네가 처리해 줘야겠어." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "맡겨 두시죠." }
    ]
  },
  {
    "DialogueId": 700415,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "깔끔하군. 하늘이 조용해졌어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이건 자네 몫일세." }
    ]
  },
  {
    "DialogueId": 700406,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "매니악 균열이 완전히 난장판이야. 캣 워커에 캣 슈터까지 뒤섞였어." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "캣 워커 열 마리, 캣 슈터 다섯 기 — 한꺼번에 정리해 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "맡겨 주십시오." }
    ]
  },
  {
    "DialogueId": 700416,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이걸 혼자 다 해치웠다고? 정말 대단하군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받게, 넉넉히 챙겼네." }
    ]
  },
  {
    "DialogueId": 700407,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "매니악 상공에 캣 슈터가 다섯 기 떠 있다는 보고야." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이번에도 자네 몫일세." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "맡겨 두시죠." }
    ]
  },
  {
    "DialogueId": 700417,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "깔끔하게 처리했군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "고생 많았네." }
    ]
  },
  {
    "DialogueId": 700408,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "그 건물 상공에 아크캐논이 떠서 조준을 걸고 있다더군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "다섯 기만 떨어뜨려 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "다녀오겠습니다." }
    ]
  },
  {
    "DialogueId": 700418,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하늘이 조용해졌군. 역시 자네야." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받게." }
    ]
  },
  {
    "DialogueId": 700409,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "던전2 하드 쪽에도 아크캐논이 떠서 조준을 걸고 있다더군." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "다섯 기만 떨어뜨려 주게." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "다녀오겠습니다." }
    ]
  },
  {
    "DialogueId": 700419,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "하늘이 또 조용해졌군. 고맙네." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "받게." }
    ]
  },
  {
    "DialogueId": 700801,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "인젝터 재고가 바닥났어요. 균열에서 회수되는 그 소형 말이에요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "다섯 개만 모아다 주시면 값은 넉넉히 쳐드릴게요." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "모아 오죠." }
    ]
  },
  {
    "DialogueId": 700811,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "딱 맞게 가져오셨네요. 이제 선반을 채울 수 있겠어요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "이건 제가 조합해 둔 거예요. 가져가세요." }
    ]
  },
  {
    "DialogueId": 700802,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "중형 인젝터를 좀 더 좋은 걸로 정제해 드릴게요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "세 개만 맡겨 주시면 대형 다섯 개로 바꿔 드릴게요." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오죠." }
    ]
  },
  {
    "DialogueId": 700812,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋아요, 딱 맞네요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "여기, 대형 인젝터 다섯 개예요." }
    ]
  },
  {
    "DialogueId": 700803,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "대형 인젝터도 더 좋은 걸로 바꿔 드릴 수 있어요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "세 개만 주시면 메가 힐링 젤리 다섯 개로 바꿔 드릴게요." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오죠." }
    ]
  },
  {
    "DialogueId": 700813,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋아요, 딱 맞네요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "여기, 메가 힐링 젤리 다섯 개예요." }
    ]
  },
  {
    "DialogueId": 700804,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "메가 힐링 젤리도 한 단계 더 올려 드릴 수 있어요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "세 개만 주시면 테라급 다섯 개로 바꿔 드릴게요." },
      { "Speaker": "Player", "Name": "", "PortraitAddress": "", "Text": "가져오죠." }
    ]
  },
  {
    "DialogueId": 700814,
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "좋아요, 딱 맞네요." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "여기, 테라 힐링 젤리 다섯 개예요." }
    ]
  },
  {
    "DialogueId": 700890,
    "Npc": "미라",
    "Lines": [
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "어서 오세요, 귀환자님." },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오늘은 뭘 찾으시나요?" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "재고가 자꾸 비어서 걱정이에요." }
    ]
  }
]
