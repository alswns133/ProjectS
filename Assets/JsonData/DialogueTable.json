      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "오늘은 뭘 찾으시나요?" },
      { "Speaker": "Npc", "Name": "", "PortraitAddress": "", "Text": "재고가 자꾸 비어서 걱정이에요." }
