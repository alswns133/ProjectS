<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ProjectSDbBackup</AssemblyName>
    <RootNamespace>ProjectS.DbBackup</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 서비스 계정 키(JSON)로 RTDB REST용 액세스 토큰을 발급받는다. -->
    <PackageReference Include="Google.Apis.Auth" Version="1.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- 설정 예시만 출력 폴더로 복사한다. 실제 설정(dbbackup.config.json)과 키는 서버 PC에서 따로 둔다. -->
    <None Update="dbbackup.config.example.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 실제 설정은 .gitignore로 커밋되지 않는다. 있을 때만 exe 옆으로 복사해 dotnet run에서도 읽히게 한다. -->
    <None Include="dbbackup.config.json" Condition="Exists('dbbackup.config.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
